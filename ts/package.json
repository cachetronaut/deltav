{
  "name": "delta-v",
  "version": "0.0.0",
  "description": "DeltaV reservation-based budget enforcement for agent and tool runs: pure core contracts plus a zero-service local store.",
  "keywords": [
    "delta-v",
    "deltav",
    "agent-fabric",
    "budget",
    "reservation",
    "cost-control",
    "agents",
    "typescript",
    "esm"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cachetronaut/deltav.git"
  },
  "homepage": "https://github.com/cachetronaut/deltav#readme",
  "bugs": {
    "url": "https://github.com/cachetronaut/deltav/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./store-local": {
      "types": "./dist/store-local.d.ts",
      "import": "./dist/store-local.js"
    },
    "./store-postgres": {
      "types": "./dist/store-postgres.d.ts",
      "import": "./dist/store-postgres.js"
    },
    "./store-convex": {
      "types": "./dist/store-convex.d.ts",
      "import": "./dist/store-convex.js"
    },
    "./store-remote": {
      "types": "./dist/store-remote.d.ts",
      "import": "./dist/store-remote.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "tsup",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm verify && pnpm build",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "verify": "pnpm check && pnpm typecheck && pnpm test"
  },
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "current",
        "darwin"
      ],
      "cpu": [
        "current",
        "arm64"
      ]
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.0.6",
    "@types/pg": "^8.15.5",
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "pg": "^8.16.3"
  }
}
