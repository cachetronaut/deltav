{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@delta-v/core": ["packages/core/src/index.ts"],
      "@delta-v/store-convex": ["packages/store-convex/src/index.ts"],
      "@delta-v/store-local": ["packages/store-local/src/index.ts"],
      "@delta-v/store-postgres": ["packages/store-postgres/src/index.ts"],
      "@delta-v/store-remote": ["packages/store-remote/src/index.ts"],
      "@delta-v/testkit": ["packages/testkit/src/index.ts"],
      "@dockbay/convex": ["../../dockbay/ts/packages/convex/src/index.ts"],
      "@dockbay/core": ["../../dockbay/ts/packages/core/src/index.ts"],
      "@dockbay/memory": ["../../dockbay/ts/packages/memory/src/index.ts"],
      "@dockbay/postgres": ["../../dockbay/ts/packages/postgres/src/index.ts"]
    },
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  }
}
